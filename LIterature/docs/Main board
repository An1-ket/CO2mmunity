import time
import serial
import smbus2
import board
import adafruit_ssd1306
import digitalio
import os

# OLED Display Setup
WIDTH, HEIGHT = 128, 64
i2c = board.I2C()
oled = adafruit_ssd1306.SSD1306_I2C(WIDTH, HEIGHT, i2c)

# CO2 Sensor Setup
co2_port = "/dev/ttyUSB0"
co2_baudrate = 9600
ser = serial.Serial(co2_port, co2_baudrate, timeout=1)

# DS18B20 Temperature Sensor
def read_temperature():
    try:
        base_dir = "/sys/bus/w1/devices/"
        device_folder = [d for d in os.listdir(base_dir) if d.startswith("28-")][0]
        device_file = f"{base_dir}{device_folder}/w1_slave"
        with open(device_file, "r") as f:
            lines = f.readlines()
        if "YES" in lines[0]:
            temp_str = lines[1].split("t=")[-1]
            return round(int(temp_str) / 1000.0, 2)
    except:
        return None  # Return None if sensor not found

# Read CO2
def read_co2():
    try:
        ser.write(b"\xFE\x44\x00\x08\x02\x9F\x25")
        time.sleep(0.1)
        response = ser.read(7)
        if len(response) == 7:
            high, low = response[3], response[4]
            return (high << 8) | low
    except:
        return None  # Return None if sensor not found

# Main Loop
while True:
    co2 = read_co2()
    temp = read_temperature()

    # Display Data on OLED
    oled.fill(0)
    oled.text(f"CO2: {co2 if co2 else 'ERROR'} ppm", 0, 0, 1)
    oled.text(f"Temp: {temp if temp else 'ERROR'} C", 0, 20, 1)
    oled.show()

    time.sleep(20)  # Update every 20 seconds

